INTAKE_MAX_PATHNAME_LENGTH=4096
INTAKE_MAX_PLIST_BYTES=16777216
INTAKE_MAX_SQLITE_MAIN_BYTES=1073741824
INTAKE_MAX_SQLITE_WAL_BYTES=1073741824
INTAKE_MAX_SQLITE_SHM_BYTES=67108864
INTAKE_MAX_CONTROLLED_COPY_BYTES=2214592512
INTAKE_MAX_SCHEMA_ENTRIES=100000
INTAKE_MAX_SQLITE_WORK_UNITS=100000000
